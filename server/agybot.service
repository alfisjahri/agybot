[Unit]
Description=AgyBot - bot framework with agy CLI (Antigravity Pro)
After=network.target

[Service]
Type=simple
User=muse
WorkingDirectory=/home/ubuntu/agybot
Environment=AGYBOT_PORT=8898
ExecStart=/home/ubuntu/agybot/venv/bin/python /home/ubuntu/agybot/app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
